<Application
    x:Class="NetLens.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Typography.xaml"/>
                <ResourceDictionary Source="Styles/Cards.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global app accent -->
            <SolidColorBrush x:Key="NetLensAccentBrush" Color="#0078D4"/>
            <SolidColorBrush x:Key="NetLensCriticalBrush" Color="#C42B1C"/>
            <SolidColorBrush x:Key="NetLensWarningBrush" Color="#9D5D00"/>
            <SolidColorBrush x:Key="NetLensGoodBrush" Color="#107C10"/>
            <SolidColorBrush x:Key="NetLensExcellentBrush" Color="#00B7C3"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#2D2D2D"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
