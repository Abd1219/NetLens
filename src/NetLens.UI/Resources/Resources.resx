  </data>
  <data name="Rule_DNS_SLOW_Recommendation" xml:space="preserve">
    <value>Verify DNS server status or configure a faster DNS resolver.</value>
  </data>
  <data name="Rule_CONNECTIVITY_FULL_LOSS_Title" xml:space="preserve">
    <value>Full Connectivity Loss</value>
  </data>
  <data name="Rule_CONNECTIVITY_FULL_LOSS_Description" xml:space="preserve">
    <value>Gateway and external destinations are completely unreachable.</value>
  </data>
  <data name="Rule_CONNECTIVITY_FULL_LOSS_Recommendation" xml:space="preserve">
    <value>Check physical connection, Wi-Fi association, or restart router.</value>
  </data>
  <data name="Rule_CONNECTIVITY_PARTIAL_Title" xml:space="preserve">
