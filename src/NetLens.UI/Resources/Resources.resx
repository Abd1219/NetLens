  </data>
  <data name="Rule_HIGH_PACKET_LOSS_Recommendation" xml:space="preserve">
    <value>Check for RF interference, bad cabling, or network dropouts.</value>
  </data>
  <data name="Rule_HIGH_JITTER_Title" xml:space="preserve">
