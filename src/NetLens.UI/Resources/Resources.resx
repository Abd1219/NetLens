  </data>
  <data name="Rule_CONNECTIVITY_PARTIAL_Description" xml:space="preserve">
    <value>Local gateway reachable but internet connectivity failed.</value>
  </data>
  <data name="Rule_CONNECTIVITY_PARTIAL_Recommendation" xml:space="preserve">
    <value>Verify ISP modem status and upstream WAN link.</value>
  </data>
  <data name="Rule_POSSIBLE_INTERFERENCE_Title" xml:space="preserve">
    <value>Possible Wi-Fi Interference</value>
  </data>
  <data name="Rule_POSSIBLE_INTERFERENCE_Description" xml:space="preserve">
    <value>Combination of low PHY rate and jitter indicates RF interference.</value>
  </data>
  <data name="Rule_POSSIBLE_INTERFERENCE_Recommendation" xml:space="preserve">
    <value>Switch Wi-Fi channel to an uncrowded frequency band.</value>
  </data>
