  <data name="Rule_SIGNAL_DEGRADATION_Description" xml:space="preserve">
    <value>Signal quality exhibits progressive degradation.</value>
  </data>
  <data name="Rule_SIGNAL_DEGRADATION_Recommendation" xml:space="preserve">
