  </data>
  <data name="Rule_HIGH_JITTER_Description" xml:space="preserve">
    <value>Latency variation is causing packet delivery delay fluctuation.</value>
  </data>
  <data name="Rule_HIGH_JITTER_Recommendation" xml:space="preserve">
    <value>Reduce background network activity and channel interference.</value>
  </data>
  <data name="Rule_DNS_SLOW_Title" xml:space="preserve">
