<Page
    x:Class="NetLens.UI.Views.WifiExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#141414">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20" Spacing="24">

            <!-- Title Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Wi-Fi Explorer" FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
                <TextBlock Text="Real-time scanning and RF environment analysis" FontSize="14" Foreground="#888888"/>
            </StackPanel>

            <!-- Current Connected AP Details -->
            <Border Padding="18" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="Active Association" FontSize="14" FontWeight="SemiBold" Foreground="#0078D4"/>

                    <Grid ColumnSpacing="20" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SSID -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="SSID" FontSize="11" Foreground="#666666"/>
                            <TextBlock Text="{Binding Ssid}" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                        </StackPanel>

                        <!-- BSSID -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="BSSID" FontSize="11" Foreground="#666666"/>
                            <TextBlock Text="{Binding Bssid}" FontSize="14" FontFamily="Cascadia Code" Foreground="#AAAAAA"/>
                        </StackPanel>

                        <!-- Signal -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <TextBlock Text="RSSI" FontSize="11" Foreground="#666666"/>
                            <TextBlock Text="{Binding Rssi}" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                        </StackPanel>

                        <!-- Channel -->
                        <StackPanel Grid.Row="0" Grid.Column="3" Spacing="4">
                            <TextBlock Text="Channel" FontSize="11" Foreground="#666666"/>
                            <TextBlock Text="{Binding Channel}" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Surrounding APs Table -->
            <Border Padding="18" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="Detected Surrounding Access Points" FontSize="14" FontWeight="SemiBold" Foreground="#E8E8E8"/>

                    <!-- Table Header -->
                    <Grid Padding="12,8" Background="#242424" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SSID" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="1" Text="BSSID" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="2" Text="Signal" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="3" Text="Channel" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="4" Text="Security" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="5" Text="Standard" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                    </Grid>

                    <!-- Items -->
                    <ItemsControl ItemsSource="{Binding SurroundingNetworks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Ssid}" FontSize="13" Foreground="#E8E8E8" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Bssid}" FontSize="12" FontFamily="Cascadia Code" Foreground="#888888" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Rssi}" FontSize="13" Foreground="#E8E8E8"/>
                                        <TextBlock Text="dBm" FontSize="11" Foreground="#666666" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Channel}" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Security}" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Standards}" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
