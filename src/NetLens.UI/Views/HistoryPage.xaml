<Page
    x:Class="NetLens.UI.Views.HistoryPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NetLens.UI.Converters"
    Background="#141414">

    <Page.Resources>
        <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20" Spacing="24">

            <!-- Title Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="TitleText" Text="Diagnostic History" FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
                    <TextBlock x:Name="SubtitleText" Text="Stored diagnostic records and PDF report exports" FontSize="14" Foreground="#888888"/>
                </StackPanel>

                <Button x:Name="RefreshBtn"
                        Grid.Column="1"
                        Content="Refresh History"
                        Command="{Binding LoadSessionsCommand}"
                        Style="{StaticResource DefaultButtonStyle}"
                        Padding="16,8"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Stored Sessions List -->
            <Border Padding="18" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="SessionsHeader" Text="Flight Recorder Sessions" FontSize="14" FontWeight="SemiBold" Foreground="#E8E8E8"/>

                    <!-- Table Header -->
                    <Grid Padding="12,8" Background="#242424" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Col_DateTime" Grid.Column="0" Text="Date / Time" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock x:Name="Col_ClientName" Grid.Column="1" Text="Client Name" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock x:Name="Col_Site" Grid.Column="2" Text="Site / Location" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock x:Name="Col_Snapshots" Grid.Column="3" Text="Snapshots" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock x:Name="Col_Events" Grid.Column="4" Text="Events" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                        <TextBlock x:Name="Col_Action" Grid.Column="5" Text="Action" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" Width="100" TextAlignment="Center"/>
                    </Grid>

                    <!-- Items -->
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding StartedAt}" FontSize="13" Foreground="#E8E8E8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ClientName}" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SiteName}" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SnapshotCount}" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding EventCount}" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>

                                    <Button Grid.Column="5"
                                            Content="{Binding Tag, ElementName=ExportBtnText, TargetNullValue='Export PDF'}"
                                            Width="100"
                                            Command="{Binding DataContext.ExportReportCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DefaultButtonStyle}"
                                            Padding="10,4"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ExportBtnText" Visibility="Collapsed"/>

                    <!-- Empty state -->
                    <StackPanel
                        Visibility="{Binding Sessions.Count, Converter={StaticResource ZeroToVisibleConverter}}"
                        HorizontalAlignment="Center" Spacing="8" Padding="0,48">
                        <TextBlock Text="ℹ" FontSize="36" Foreground="#0078D4" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NoSessionsText" Text="No stored diagnostic sessions found." FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
