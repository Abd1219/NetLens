<Page
    x:Class="NetLens.UI.Views.DiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NetLens.UI.Converters"
    xmlns:viewmodels="using:NetLens.UI.ViewModels"
    Background="#141414">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,20" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Responsive Visual States -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="DiscoveryLayoutGroup">
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="850"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SubnetPane.(Grid.Row)" Value="0"/>
                            <Setter Target="SubnetPane.(Grid.Column)" Value="0"/>
                            <Setter Target="SubnetPane.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="TracePane.(Grid.Row)" Value="0"/>
                            <Setter Target="TracePane.(Grid.Column)" Value="1"/>
                            <Setter Target="TracePane.(Grid.ColumnSpan)" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="SubnetPane.(Grid.Row)" Value="0"/>
                            <Setter Target="SubnetPane.(Grid.Column)" Value="0"/>
                            <Setter Target="SubnetPane.(Grid.ColumnSpan)" Value="2"/>

                            <Setter Target="TracePane.(Grid.Row)" Value="1"/>
                            <Setter Target="TracePane.(Grid.Column)" Value="0"/>
                            <Setter Target="TracePane.(Grid.ColumnSpan)" Value="2"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Title Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Name="TitleText" Text="Network Discovery" FontSize="28" FontWeight="Bold" Foreground="#E8E8E8"/>
                <TextBlock x:Name="SubtitleText" Text="Scan the local subnet and run path trace diagnostics" FontSize="14" Foreground="#888888"/>
            </StackPanel>

            <!-- Main Content split into Subnet Scan and Traceroute -->
            <Grid Grid.Row="1" RowSpacing="16" ColumnSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Subnet Scanner -->
                <Border x:Name="SubnetPane" Grid.Row="0" Grid.Column="0" Padding="18" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1" MinHeight="350">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Scan Control Panel -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="SubnetScanHeader" Text="Subnet Scan" FontSize="16" FontWeight="SemiBold" Foreground="#E8E8E8"/>
                                    <Border Background="#2B2B2B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SubnetRange}" FontSize="11" FontWeight="Bold" Foreground="#0078D4"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#888888"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button x:Name="ScanBtn"
                                        Content="Scan Network"
                                        Command="{Binding StartScanCommand}"
                                        Visibility="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        MinWidth="110"/>
                                <Button x:Name="CancelBtn"
                                        Content="Cancel"
                                        Command="{Binding CancelScanCommand}"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                                        MinWidth="110"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress Bar -->
                        <ProgressBar Grid.Row="1"
                                     Value="{Binding ProgressPercentage}"
                                     Maximum="100"
                                     Height="4"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Discovered Devices Table -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Grid Grid.Row="0" Padding="12,8" Background="#242424" CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Col_Ip" Grid.Column="0" Text="IP Address" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                                <TextBlock x:Name="Col_Mac" Grid.Column="1" Text="MAC Address" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                                <TextBlock x:Name="Col_Host" Grid.Column="2" Text="Hostname" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                                <TextBlock x:Name="Col_Latency" Grid.Column="3" Text="Latency" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                                <TextBlock x:Name="Col_Type" Grid.Column="4" Text="Type" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA"/>
                                <TextBlock x:Name="Col_Action" Grid.Column="5" Text="Action" FontSize="12" FontWeight="SemiBold" Foreground="#AAAAAA" TextAlignment="Center"/>
                            </Grid>

                            <!-- Devices ListView -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding DeviceRows}"
                                      SelectionMode="Single"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      Padding="0,6,0,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:DeviceRowViewModel">
                                        <Grid Padding="12,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{x:Bind IpAddress}" FontSize="13" Foreground="#E8E8E8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind MacAddress}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Hostname}" FontSize="13" Foreground="#E8E8E8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind LatencyMs}" FontSize="13" Foreground="#E8E8E8" VerticalAlignment="Center"/>

                                            <!-- Device Type Badge -->
                                            <Border Grid.Column="4" Background="#2B2B2B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DeviceType}" FontSize="11" Foreground="#AAAAAA"/>
                                            </Border>

                                            <!-- Traceroute Action Button -->
                                            <Button Grid.Column="5"
                                                    Content="Trace"
                                                    FontSize="11"
                                                    Padding="8,4"
                                                    Command="{x:Bind TraceCommand}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Pane: Traceroute Diagnostics -->
                <Border x:Name="TracePane" Grid.Row="0" Grid.Column="1" Padding="18" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1" MinHeight="350">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="8">
                            <TextBlock x:Name="TracerouteTitle" Text="Traceroute Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="#E8E8E8"/>

                            <Grid ColumnSpacing="8" Visibility="{Binding IsTracerouting, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ProgressRing IsActive="True" Width="16" Height="16" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TracerouteStatusMessage}" FontSize="12" Foreground="#888888" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding TracerouteHeaderMessage}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#0078D4"
                                       Visibility="{Binding IsTracerouting, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Hops ListView -->
                        <ListView Grid.Row="1" ItemsSource="{Binding TracerouteHops}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:HopRowViewModel">
                                    <Grid Padding="8,10" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Hop Number -->
                                        <Border Grid.Column="0" Background="#242424" CornerRadius="12" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind HopNumber}" FontSize="11" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Hop Hostname & IP -->
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{x:Bind IpAddress}" FontSize="13" Foreground="#E8E8E8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Hostname}" FontSize="11" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Average Latency -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind AverageLatency}" FontSize="13" FontWeight="SemiBold" Foreground="#E8E8E8" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
