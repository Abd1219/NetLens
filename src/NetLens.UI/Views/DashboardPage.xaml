<Page
    x:Class="NetLens.UI.Views.DashboardPage"
    x:Name="DashboardPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:converters="using:NetLens.UI.Converters"
    Background="#141414">

    <Page.Resources>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter"/>
        <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20" Spacing="20">

            <!-- ── Visual States for Responsive Design ───────────────────────── -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutVisualStates">
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1300"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <!-- 3 Charts Side-by-Side in Row 0 -->
                            <Setter Target="Chart1Card.(Grid.Row)" Value="0"/>
                            <Setter Target="Chart1Card.(Grid.Column)" Value="0"/>
                            <Setter Target="Chart1Card.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="Chart2Card.(Grid.Row)" Value="0"/>
                            <Setter Target="Chart2Card.(Grid.Column)" Value="1"/>
                            <Setter Target="Chart2Card.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="Chart3Card.(Grid.Row)" Value="0"/>
                            <Setter Target="Chart3Card.(Grid.Column)" Value="2"/>
                            <Setter Target="Chart3Card.(Grid.ColumnSpan)" Value="1"/>

                            <!-- Identity Cards Side-by-Side -->
                            <Setter Target="IdCard1.(Grid.Row)" Value="0"/>
                            <Setter Target="IdCard1.(Grid.Column)" Value="0"/>
                            <Setter Target="IdCard1.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="IdCard2.(Grid.Row)" Value="0"/>
                            <Setter Target="IdCard2.(Grid.Column)" Value="1"/>
                            <Setter Target="IdCard2.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="IdCard3.(Grid.Row)" Value="0"/>
                            <Setter Target="IdCard3.(Grid.Column)" Value="2"/>
                            <Setter Target="IdCard3.(Grid.ColumnSpan)" Value="1"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="MediumState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="850"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <!-- 2 Charts Top Row, 1 Chart Bottom Row (2+1 Layout) -->
                            <Setter Target="Chart1Card.(Grid.Row)" Value="0"/>
                            <Setter Target="Chart1Card.(Grid.Column)" Value="0"/>
                            <Setter Target="Chart1Card.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="Chart2Card.(Grid.Row)" Value="0"/>
                            <Setter Target="Chart2Card.(Grid.Column)" Value="1"/>
                            <Setter Target="Chart2Card.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="Chart3Card.(Grid.Row)" Value="1"/>
                            <Setter Target="Chart3Card.(Grid.Column)" Value="0"/>
                            <Setter Target="Chart3Card.(Grid.ColumnSpan)" Value="2"/>

                            <!-- Identity Cards 2 Top, 1 Bottom -->
                            <Setter Target="IdCard1.(Grid.Row)" Value="0"/>
                            <Setter Target="IdCard1.(Grid.Column)" Value="0"/>
                            <Setter Target="IdCard1.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="IdCard2.(Grid.Row)" Value="0"/>
                            <Setter Target="IdCard2.(Grid.Column)" Value="1"/>
                            <Setter Target="IdCard2.(Grid.ColumnSpan)" Value="1"/>

                            <Setter Target="IdCard3.(Grid.Row)" Value="1"/>
                            <Setter Target="IdCard3.(Grid.Column)" Value="0"/>
                            <Setter Target="IdCard3.(Grid.ColumnSpan)" Value="2"/>
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <!-- All 3 Charts Stacked Vertically -->
                            <Setter Target="Chart1Card.(Grid.Row)" Value="0"/>
                            <Setter Target="Chart1Card.(Grid.Column)" Value="0"/>
                            <Setter Target="Chart1Card.(Grid.ColumnSpan)" Value="3"/>

                            <Setter Target="Chart2Card.(Grid.Row)" Value="1"/>
                            <Setter Target="Chart2Card.(Grid.Column)" Value="0"/>
                            <Setter Target="Chart2Card.(Grid.ColumnSpan)" Value="3"/>

                            <Setter Target="Chart3Card.(Grid.Row)" Value="2"/>
                            <Setter Target="Chart3Card.(Grid.Column)" Value="0"/>
                            <Setter Target="Chart3Card.(Grid.ColumnSpan)" Value="3"/>

                            <!-- Identity Cards Stacked Vertically -->
                            <Setter Target="IdCard1.(Grid.Row)" Value="0"/>
                            <Setter Target="IdCard1.(Grid.Column)" Value="0"/>
                            <Setter Target="IdCard1.(Grid.ColumnSpan)" Value="3"/>

                            <Setter Target="IdCard2.(Grid.Row)" Value="1"/>
                            <Setter Target="IdCard2.(Grid.Column)" Value="0"/>
                            <Setter Target="IdCard2.(Grid.ColumnSpan)" Value="3"/>

                            <Setter Target="IdCard3.(Grid.Row)" Value="2"/>
                            <Setter Target="IdCard3.(Grid.Column)" Value="0"/>
                            <Setter Target="IdCard3.(Grid.ColumnSpan)" Value="3"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- ── Status Bar ───────────────────────────────────── -->
            <Border Padding="16,12" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding StatusColor}"/>
                            </Border.Background>
                        </Border>
                        <TextBlock
                            Text="{Binding OverallStatus}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#E8E8E8"
                            TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding Ssid}" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" ToolTipService.ToolTip="{Binding Ssid}"/>
                        <TextBlock Text="{Binding PhysicalType}" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Primary Metric Cards Grid ────────────────────── -->
            <Grid RowSpacing="12" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- RSSI Card -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Label_RSSI" Text="RSSI" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding Rssi}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SignalQuality}" Style="{StaticResource CardSubValue}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- PHY Rate Card -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Label_PhyRate" Text="PHY Rate" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding PhyTxRate}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PhyTxRate}"/>
                        <TextBlock Text="{Binding PhyRxRate}" Style="{StaticResource CardSubValue}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PhyRxRate}"/>
                    </StackPanel>
                </Border>

                <!-- Gateway Latency Card -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Label_Gateway" Text="Gateway" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding GatewayLatency}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="Label_RoundTrip" Text="Round-trip" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Packet Loss Card -->
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Label_PacketLoss" Text="Packet Loss" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding PacketLoss}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Jitter}" Style="{StaticResource CardSubValue}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- DNS Card -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Label_DNS" Text="DNS" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding DnsLatency}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DnsIp}" Style="{StaticResource CardSubValue}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DnsIp}"/>
                    </StackPanel>
                </Border>

                <!-- Internet Card -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Label_Internet" Text="Internet" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding InternetLatency}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="8.8.8.8" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Channel Card -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Label_Channel" Text="Channel" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding Channel}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Frequency}" Style="{StaticResource CardSubValue}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- CPU / RAM Card -->
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Label_System" Text="System" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding Cpu}" Style="{StaticResource CardValue}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource CardSubValue}" TextTrimming="CharacterEllipsis">
                            <Run Text="RAM: "/>
                            <Run Text="{Binding Ram}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Responsive Charts Layout ───────────────────── -->
            <Grid x:Name="ChartsGrid" RowSpacing="16" ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- RSSI Chart -->
                <Border x:Name="Chart1Card" Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartCard}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Title_ChartRSSI" Text="Signal Strength (RSSI)" Style="{StaticResource ChartTitle}"/>
                        <lvc:CartesianChart
                            MinHeight="180"
                            Series="{Binding RssiSeries}"
                            XAxes="{Binding TimeAxis}"
                            YAxes="{Binding RssiYAxis}"
                            Background="Transparent"
                            LegendPosition="Hidden"/>
                    </StackPanel>
                </Border>

                <!-- Latency Chart -->
                <Border x:Name="Chart2Card" Grid.Row="0" Grid.Column="1" Style="{StaticResource ChartCard}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Title_ChartGateway" Text="Gateway Latency" Style="{StaticResource ChartTitle}"/>
                        <lvc:CartesianChart
                            MinHeight="180"
                            Series="{Binding LatencySeries}"
                            XAxes="{Binding TimeAxis}"
                            YAxes="{Binding LatencyYAxis}"
                            Background="Transparent"
                            LegendPosition="Hidden"/>
                    </StackPanel>
                </Border>

                <!-- Packet Loss Chart -->
                <Border x:Name="Chart3Card" Grid.Row="0" Grid.Column="2" Style="{StaticResource ChartCard}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="Title_ChartPacketLoss" Text="Packet Loss" Style="{StaticResource ChartTitle}"/>
                        <lvc:CartesianChart
                            MinHeight="180"
                            Series="{Binding PacketLossSeries}"
                            XAxes="{Binding TimeAxis}"
                            Background="Transparent"
                            LegendPosition="Hidden"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Active Alerts Panel ────────────────────────── -->
            <Border Padding="16" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="Title_ActiveDiagnostics" Text="Active Diagnostics" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"/>

                    <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" CornerRadius="6" Background="#242424" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"/>

                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="#E8E8E8" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Recommendation}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#2B2B2B" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SeverityText}" FontSize="10" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel
                        Visibility="{Binding ActiveAlerts.Count, Converter={StaticResource ZeroToVisibleConverter}}"
                        HorizontalAlignment="Center" Spacing="6" Padding="0,12">
                        <TextBlock Text="✓" FontSize="24" Foreground="#107C10" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="Label_NoIssues" Text="No active issues detected" FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Correlation Analysis Panel ────────────────────────── -->
            <Border Padding="16" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding CorrelationSectionTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"/>

                    <!-- Correlations List -->
                    <ItemsControl ItemsSource="{Binding ActiveCorrelations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" CornerRadius="6" Background="#242424" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Border indicator color matching severity -->
                                        <Border Grid.Column="0" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"/>

                                        <Grid Grid.Column="1" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Title & Evidence Strength -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="#E8E8E8"/>
                                                <Border Background="#2B2B2B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StrengthText}" FontSize="10" Foreground="#0078D4" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13" Foreground="#E8E8E8" TextWrapping="Wrap"/>

                                            <!-- Bulleted evidence points -->
                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding EvidenceItems}" Margin="4,2,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#AAAAAA" Margin="0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Recommendation -->
                                            <TextBlock Grid.Row="3" Text="{Binding Recommendation}" FontSize="11" Foreground="#888888" TextWrapping="Wrap" FontStyle="Italic"/>
                                        </Grid>

                                        <!-- Right badges stack (Severity and Score) -->
                                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top">
                                            <Border Background="#2B2B2B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SeverityText}" FontSize="10" Foreground="#AAAAAA" FontWeight="SemiBold"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding EvidenceScoreLabel}" FontSize="10" Foreground="#666666"/>
                                                <TextBlock Text="{Binding EvidenceScore}" FontSize="10" Foreground="#E8E8E8" FontWeight="Bold"/>
                                                <TextBlock Text="/100" FontSize="10" Foreground="#666666"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel
                        Visibility="{Binding ActiveCorrelations.Count, Converter={StaticResource ZeroToVisibleConverter}}"
                        HorizontalAlignment="Center" Spacing="6" Padding="0,12">
                        <TextBlock Text="ℹ" FontSize="24" Foreground="#0078D4" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding NoCorrelationsMessage}" FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Network Identity Row ───────────────────────── -->
            <Grid RowSpacing="12" ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IdCard1" Grid.Row="0" Grid.Column="0" Padding="14,12" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="Label_LocalIp" Text="Local IP" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding LocalIp}" FontSize="14" Foreground="#E8E8E8" FontFamily="Cascadia Code" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding LocalIp}"/>
                        <TextBlock FontSize="11" Foreground="#666666" FontFamily="Cascadia Code" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Bssid}">
                            <Run Text="BSSID: "/>
                            <Run Text="{Binding Bssid}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border x:Name="IdCard2" Grid.Row="0" Grid.Column="1" Padding="14,12" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="Label_GatewayIp" Text="Gateway" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding GatewayIp}" FontSize="14" Foreground="#E8E8E8" FontFamily="Cascadia Code" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding GatewayIp}"/>
                        <TextBlock FontSize="11" Foreground="#666666">
                            <Run x:Name="Run_GatewayLatency" Text="Latency: "/>
                            <Run Text="{Binding GatewayLatency}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border x:Name="IdCard3" Grid.Row="0" Grid.Column="2" Padding="14,12" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="Label_DnsServer" Text="DNS Server" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding DnsIp}" FontSize="14" Foreground="#E8E8E8" FontFamily="Cascadia Code" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DnsIp}"/>
                        <TextBlock FontSize="11" Foreground="#666666">
                            <Run x:Name="Run_DnsLatency" Text="Latency: "/>
                            <Run Text="{Binding DnsLatency}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
