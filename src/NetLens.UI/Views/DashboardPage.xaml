<Page
    x:Class="NetLens.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:converters="using:NetLens.UI.Converters"
    Background="#141414">

    <Page.Resources>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter"/>
        <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20" Spacing="20">

            <!-- ── Status Bar ───────────────────────────────────── -->
            <Border Padding="16,12" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding StatusColor}"/>
                            </Border.Background>
                        </Border>
                        <TextBlock
                            Text="{Binding OverallStatus}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#E8E8E8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding Ssid}" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PhysicalType}" FontSize="12" Foreground="#666666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Primary Metric Cards Row ────────────────────── -->
            <GridView IsItemClickEnabled="False" SelectionMode="None">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,12,0"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </GridView.ItemContainerStyle>

                <!-- RSSI Card -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="RSSI" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding Rssi}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="{Binding SignalQuality}" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- PHY Rate Card -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="PHY Rate" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding PhyTxRate}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="{Binding PhyRxRate}" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Gateway Latency Card -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Gateway" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding GatewayLatency}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="Round-trip" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Packet Loss Card -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Packet Loss" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding PacketLoss}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="{Binding Jitter}" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- DNS Card -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="DNS" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding DnsLatency}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="{Binding DnsIp}" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Internet Card -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Internet" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding InternetLatency}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="8.8.8.8" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- Channel Card -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Channel" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding Channel}" Style="{StaticResource CardValue}"/>
                        <TextBlock Text="{Binding Frequency}" Style="{StaticResource CardSubValue}"/>
                    </StackPanel>
                </Border>

                <!-- CPU / RAM Card -->
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="System" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding Cpu}" Style="{StaticResource CardValue}"/>
                        <TextBlock Style="{StaticResource CardSubValue}">
                            <Run Text="RAM: "/>
                            <Run Text="{Binding Ram}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </GridView>

            <!-- ── Charts Row ─────────────────────────────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- RSSI Chart -->
                <Border Grid.Column="0" Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <TextBlock Text="Signal Strength (RSSI)" Style="{StaticResource ChartTitle}"/>
                        <lvc:CartesianChart
                            Height="140"
                            Series="{Binding RssiSeries}"
                            XAxes="{Binding TimeAxis}"
                            YAxes="{Binding RssiYAxis}"
                            Background="Transparent"
                            LegendPosition="Hidden"/>
                    </StackPanel>
                </Border>

                <!-- Latency Chart -->
                <Border Grid.Column="1" Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <TextBlock Text="Gateway Latency" Style="{StaticResource ChartTitle}"/>
                        <lvc:CartesianChart
                            Height="140"
                            Series="{Binding LatencySeries}"
                            XAxes="{Binding TimeAxis}"
                            YAxes="{Binding LatencyYAxis}"
                            Background="Transparent"
                            LegendPosition="Hidden"/>
                    </StackPanel>
                </Border>

                <!-- Packet Loss Chart -->
                <Border Grid.Column="2" Style="{StaticResource ChartCard}">
                    <StackPanel>
                        <TextBlock Text="Packet Loss" Style="{StaticResource ChartTitle}"/>
                        <lvc:CartesianChart
                            Height="140"
                            Series="{Binding PacketLossSeries}"
                            XAxes="{Binding TimeAxis}"
                            Background="Transparent"
                            LegendPosition="Hidden"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Active Alerts Panel ────────────────────────── -->
            <Border Padding="16" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Active Diagnostics" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA"/>

                    <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" CornerRadius="6" Background="#242424" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}"/>

                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="#E8E8E8" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Recommendation}" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel
                        Visibility="{Binding ActiveAlerts.Count, Converter={StaticResource ZeroToVisibleConverter}}"
                        HorizontalAlignment="Center" Spacing="6" Padding="0,12">
                        <TextBlock Text="✓" FontSize="24" Foreground="#107C10" HorizontalAlignment="Center"/>
                        <TextBlock Text="No active issues detected" FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Network Identity Row ───────────────────────── -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Padding="14,12" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Local IP" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding LocalIp}" FontSize="14" Foreground="#E8E8E8" FontFamily="Cascadia Code"/>
                        <TextBlock FontSize="11" Foreground="#666666" FontFamily="Cascadia Code">
                            <Run Text="BSSID: "/>
                            <Run Text="{Binding Bssid}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="14,12" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Gateway" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding GatewayIp}" FontSize="14" Foreground="#E8E8E8" FontFamily="Cascadia Code"/>
                        <TextBlock FontSize="11" Foreground="#666666">
                            <Run Text="Latency: "/>
                            <Run Text="{Binding GatewayLatency}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="14,12" CornerRadius="8" Background="#1C1C1C" BorderBrush="#2D2D2D" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="DNS Server" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding DnsIp}" FontSize="14" Foreground="#E8E8E8" FontFamily="Cascadia Code"/>
                        <TextBlock FontSize="11" Foreground="#666666">
                            <Run Text="Latency: "/>
                            <Run Text="{Binding DnsLatency}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
