<Window
    x:Class="NetLens.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NetLens.UI.Views"
    Title="">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="NavView_SelectionChanged"
            IsSettingsVisible="True"
            Background="#141414">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavItem_Dashboard"
                    Tag="Dashboard"
                    Icon="Home"
                    Content="Dashboard"
                    ToolTipService.ToolTip="Real-time network overview"/>

                <NavigationViewItem x:Name="NavItem_Wifi" Content="WiFi" Tag="WifiExplorer">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE701;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItem_Discovery"
                    Tag="Discovery"
                    Icon="Find"
                    Content="Discovery"
                    ToolTipService.ToolTip="Scan local subnet and trace routes"/>

                <NavigationViewItem
                    x:Name="NavItem_Diagnostics"
                    Tag="Diagnostics"
                    Icon="Repair"
                    Content="Active Tests"
                    ToolTipService.ToolTip="Run ping, traceroute, DNS and bandwidth tests"/>

                <NavigationViewItemSeparator/>

                <NavigationViewItem
                    x:Name="NavItem_History"
                    Tag="History"
                    Icon="Clock"
                    Content="Session History"
                    ToolTipService.ToolTip="Browse past diagnostic sessions"/>
            </NavigationView.MenuItems>

            <!-- Pane header: NetLens branding -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Vertical" Margin="16,12,16,8">
                    <TextBlock
                        x:Name="PaneHeaderTitle"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="#E8E8E8"
                        FontFamily="Segoe UI Variable Display"/>
                    <TextBlock
                        x:Name="PaneHeaderSubtitle"
                        FontSize="11"
                        Foreground="#888888"
                        Margin="0,2,0,0"/>
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- Pane footer: connection status badge -->
            <NavigationView.PaneFooter>
                <Border
                    Margin="12,0,12,12"
                    Padding="10,8"
                    CornerRadius="6"
                    Background="#1C2730">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="StatusDot"
                            Width="8" Height="8"
                            Fill="#107C10"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            x:Name="StatusText"
                            Text="Monitoring"
                            FontSize="12"
                            Foreground="#AAAAAA"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Main content frame -->
            <Frame x:Name="ContentFrame" Background="#141414"/>
        </NavigationView>
    </Grid>
</Window>
